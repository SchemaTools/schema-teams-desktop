# Адрес сервера Schema Teams, зашивается в сборку (ТЗ, 9.1)
SERVER_URL=http://<SERVER_HOST>:<APP_PORT>
# Серверы бюро для путей \\сервер\…, через запятую (ТЗ, 7.2). Хост сервера Teams разрешён всегда;
# к остальным приложение обращается только после подтверждения пользователя
UNC_HOSTS=<FILE_SERVER_HOST>,<FILE_SERVER_HOST_2>
# Подпись — сертификатом бюро из хранилища Windows: npm run dist:signed (пароль и .pfx здесь не нужны)
# Публичный сертификат бюро для плагинов (.cer, не ключ) — путь вне репозитория. Desktop импортирует
# его в «Доверенные корневые» и «Доверенные издатели» пользователя перед первой установкой набора.
# Не задан — импорт выключен
PLUGIN_CERT_PATH=
# Папки бюро для %APPDATA%\Schema\bureau.txt (пишется, только если файла нет; пустые не пишутся)
BUREAU_FEEDBACK_FOLDER=\\<FILE_SERVER>\<SHARE>\Обратная связь
BUREAU_DELETE_LOG_FOLDER=\\<FILE_SERVER>\<SHARE>\Журнал удалений
BUREAU_MCP_SCENARIOS=\\<FILE_SERVER>\<SHARE>\Сценарии SchemaMCP
BUREAU_LIBRARY_FOLDER=\\<FILE_SERVER>\<SHARE>\Библиотека
BUREAU_SETTINGS_FOLDER=\\<FILE_SERVER>\<SHARE>\Настройки Schema
